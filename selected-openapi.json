{
  "openapi": "3.1.0",
  "info": {
    "title": "Front selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api2.frontapp.com"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "operationId": "front_list_contacts",
        "summary": "Read one bounded page of contacts.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "front_create_contact",
        "summary": "Create an email contact with explicit handles; no message is sent.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "handles": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "handle": {
                          "type": "string",
                          "minLength": 1
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "email"
                          ]
                        }
                      },
                      "required": [
                        "handle",
                        "source"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "handles"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
